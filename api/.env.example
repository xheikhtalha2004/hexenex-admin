# Copy to .env and fill in real values. Never commit .env.

# Postgres connection used by Prisma
DATABASE_URL="postgresql://marble_app:CHANGE_ME@127.0.0.1:5432/marble_granite_erp?schema=public"

# JWT access token signing secret (min 32 random chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_ACCESS_SECRET"
JWT_ACCESS_TTL="15m"

# Refresh token signing secret — MUST be different from the access secret.
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_SECRET"
JWT_REFRESH_TTL_DAYS="30"

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS="http://localhost:3000"

# Cookie settings
COOKIE_SECRET="CHANGE_ME_COOKIE_SECRET"
NODE_ENV="development"

PORT="4000"
